{
  "expo": {
    "name": "Sajha Kaam",
    "slug": "sajha-kaam",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "sajhakaam",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "np.sajhakaam.app"
    },
    "android": {
      "package": "np.sajhakaam.app",
      "adaptiveIcon": {
        "backgroundColor": "#1C3A2E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Sajha Kaam · साझा काम",
      "themeColor": "#1C3A2E",
      "backgroundColor": "#F1ECE3"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1C3A2E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "backgroundColor": "#F1ECE3"
  }
}