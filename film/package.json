{
  "name": "sajha-kaam-film",
  "version": "1.0.0",
  "private": true,
  "description": "Hand-drawn storyboard animatic for Sajha Kaam",
  "scripts": {
    "studio": "remotion studio",
    "paper": "remotion still PaperGrain public/paper-grain.png",
    "render:story": "remotion render SajhaKaamStory out/story.mp4",
    "render:demo": "remotion render SajhaKaamDemo out/demo.mp4",
    "render:all": "npm run render:story && npm run render:demo",
    "stills": "node scripts/stills.mjs",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@remotion/cli": "4.0.540",
    "@remotion/google-fonts": "4.0.540",
    "@remotion/paths": "4.0.540",
    "@remotion/transitions": "4.0.540",
    "p5": "2.2.3",
    "p5.brush": "2.2.3",
    "paper": "0.17.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.540",
    "roughjs": "4.6.6",
    "zdog": "1.1.3"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}
