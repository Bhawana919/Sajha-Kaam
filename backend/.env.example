# Optional. Copy to .env (Copy-Item .env.example .env) and start.ps1 will read it.
# Without a .env file these defaults are used, which is fine for the local demo.
DEMO_MODE=1
JWT_SECRET=change-me
# SIGNING_SEED_B64=any-long-secret-string   (unset: derived from JWT_SECRET)

# The first check is offline by default (no AI, no cost, nothing leaves your laptop).
# The AI helper runs only if this is set AND the Anchor turned it on AND the client allowed it.
LLM_PROVIDER=none
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-5-5

# Let the first check read public GitHub pull requests and Google Docs (1) or never fetch links (0).
READ_LINKS=1
